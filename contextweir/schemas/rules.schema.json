{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contextweir-rules.schema.json",
  "$comment": "Made by ContextWeir 0.5.6.0 (node contextweir.js --schema rules). Directed by Harahel-Whot. Written by Claude Opus 5.5 (Anthropic). Licence: MIT. A schema checks shapes and ranges only: run node contextweir.js --check as well.",
  "title": "ContextWeir rule file (rules.json, or an exported rule set)",
  "type": "object",
  "required": [
    "format",
    "groups"
  ],
  "properties": {
    "_about": {
      "type": "string"
    },
    "format": {
      "const": "contextweir-rules"
    },
    "version": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "name",
          "rules"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "unique; a set of rules"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "rules": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "name",
                "target",
                "test",
                "value"
              ],
              "properties": {
                "target": {
                  "enum": [
                    "reply",
                    "prompt",
                    "lastUser",
                    "lastMessage"
                  ],
                  "description": "reply, prompt (every message), lastUser (the player's last message), lastMessage (the last message sent)"
                },
                "test": {
                  "enum": [
                    "startsWith",
                    "contains",
                    "missing",
                    "regex",
                    "regexMissing"
                  ],
                  "description": "startsWith / contains / missing ignore case; regex / regexMissing are patterns"
                },
                "value": {
                  "type": "string",
                  "maxLength": 200
                },
                "flags": {
                  "type": "string",
                  "pattern": "^[imsu]{0,4}$",
                  "description": "pattern flags, e.g. \"i\" to ignore case"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "unique within its set"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "severity": {
                  "enum": [
                    "note",
                    "warning",
                    "serious"
                  ],
                  "default": "warning"
                },
                "unless": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "required": [
                      "target",
                      "test",
                      "value"
                    ],
                    "properties": {
                      "target": {
                        "enum": [
                          "reply",
                          "prompt",
                          "lastUser",
                          "lastMessage"
                        ],
                        "description": "reply, prompt (every message), lastUser (the player's last message), lastMessage (the last message sent)"
                      },
                      "test": {
                        "enum": [
                          "startsWith",
                          "contains",
                          "missing",
                          "regex",
                          "regexMissing"
                        ],
                        "description": "startsWith / contains / missing ignore case; regex / regexMissing are patterns"
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "flags": {
                        "type": "string",
                        "pattern": "^[imsu]{0,4}$",
                        "description": "pattern flags, e.g. \"i\" to ignore case"
                      }
                    }
                  },
                  "description": "the rule is skipped when any of these holds"
                },
                "note": {
                  "type": "string",
                  "maxLength": 500,
                  "description": "why this rule exists"
                }
              }
            }
          }
        }
      }
    }
  }
}
